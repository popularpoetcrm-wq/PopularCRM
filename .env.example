# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# New dashboard may show "publishable" — same role as anon for client:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DEFAULT_TENANT_ID=aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa

# Domains
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_POET_URL=https://popularpoet.pl
# P24-bound: trials + events checkout
TICKETS_PUBLIC_URL=https://populartickets.pl
NEXT_PUBLIC_TICKETS_URL=https://populartickets.pl
NEXT_PUBLIC_API_URL=http://localhost:3000

# Przelewy24 (merchant on populartickets)
P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC=
P24_API_KEY=
P24_SANDBOX=true

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=PopularPoetBot
TELEGRAM_WEBHOOK_SECRET=

# SaldeoSMART (API-XML ≥3.0) — docs/SALDEO.md
# Prod: https://saldeo.brainshare.pl
# Test: https://saldeo-test.brainshare.pl
SALDEO_API_URL=https://saldeo.brainshare.pl
SALDEO_USERNAME=
SALDEO_API_TOKEN=
SALDEO_COMPANY_PROGRAM_ID=

# Fakturownia (API token: Ustawienia → Integracja → Kod autoryzacyjny API)
# Domain = account subdomain only, e.g. poppoet
FAKTUROWNIA_DOMAIN=
FAKTUROWNIA_API_TOKEN=

# Email
RESEND_API_KEY=
EMAIL_FROM="Popular <noreply@populartickets.pl>"

CRON_SECRET=dev-cron-secret

# Signed session cookies (required in production; falls back to other secrets if unset)
SESSION_SECRET=
# Local only — never enable in production
# ALLOW_DEBUG_OTP=true
